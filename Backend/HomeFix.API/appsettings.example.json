{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<DB_HOST>;Database=HomeFixDb;User Id=<DB_USER>;Password=<DB_PASSWORD>;Encrypt=True;TrustServerCertificate=False;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "api.example.com",
  "Jwt": {
    "Issuer": "HomeFix.API",
    "Audience": "HomeFix.Mobile",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Email": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "Username": "<SMTP_USERNAME>",
    "Password": "<SMTP_PASSWORD>",
    "From": "<SMTP_FROM>",
    "EnableSsl": true
  }
}
